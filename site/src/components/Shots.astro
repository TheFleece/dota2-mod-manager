---
/**
 * The screenshots, as a deck rather than a stack down the page.
 *
 * Before, three pictures each took a third of the screen and did nothing but nudge upwards
 * when pointed at. Now they are one card at a time in a fanned deck: the current one faces
 * you, the others stand behind it turned away. It advances on its own, stops the moment you
 * touch it, and you can steer it - buttons, dots, keyboard, or a swipe.
 *
 * The card leans away from the pointer while you are on it, the way a card held in a hand
 * catches the light, and it comes level as you leave.
 *
 * The whole thing collapses to a plain scrollable row when the visitor asked for less
 * motion: same pictures, same captions, no theatre.
 */
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  shots: Array<{ file: string; caption: string; alt: string; label: string }>;
  prev: string;
  next: string;
}
const { lang, shots, prev, next } = Astro.props;
const src = (name: string) => `/screenshots/${lang}-${name}.webp`;
---

<div class="deck" id="deck" data-count={shots.length}>
  <div class="stage">
    {shots.map((s, i) => (
      <figure class="slide" data-i={i} aria-hidden={i === 0 ? 'false' : 'true'}>
        <div class="tilt">
          <div class="frame">
            <div class="frame-bar">
              <i></i><i></i><i></i>
              <span>{s.label}</span>
            </div>
            <img src={src(s.file)} width="1360" height="860" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" alt={s.alt} />
            <div class="sheen"></div>
          </div>
        </div>
        <figcaption>{s.caption}</figcaption>
      </figure>
    ))}
  </div>

  <div class="deck-controls">
    <button class="round" type="button" data-step="-1" aria-label={prev}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
    </button>
    <div class="deck-dots" role="tablist">
      {shots.map((s, i) => (
        <button class="deck-dot" type="button" role="tab" data-go={i} aria-label={s.label} aria-selected={i === 0}>
          <span></span>
        </button>
      ))}
    </div>
    <button class="round" type="button" data-step="1" aria-label={next}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
    </button>
  </div>
</div>

<script>
  const deck = document.getElementById('deck');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (deck) {
    const slides = [...deck.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...deck.querySelectorAll<HTMLElement>('.deck-dot')];
    let at = 0;
    let timer = 0;

    const show = (n: number) => {
      at = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        // how far this card is from the front, signed, wrapped the short way round
        let d = i - at;
        if (d > slides.length / 2) d -= slides.length;
        if (d < -slides.length / 2) d += slides.length;
        s.style.setProperty('--d', String(d));
        s.classList.toggle('front', d === 0);
        s.setAttribute('aria-hidden', d === 0 ? 'false' : 'true');
      });
      dots.forEach((b, i) => b.setAttribute('aria-selected', String(i === at)));
    };

    const play = () => {
      if (still) return;
      stop();
      timer = window.setInterval(() => show(at + 1), 6000);
    };
    const stop = () => { if (timer) { clearInterval(timer); timer = 0; } };

    deck.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement).closest('[data-step], [data-go]') as HTMLElement | null;
      if (!el) return;
      if (el.dataset.step) show(at + Number(el.dataset.step));
      else show(Number(el.dataset.go));
      play();                                  // a nudge restarts the clock, never stops it dead
    });

    // pointing at it, or tabbing into it, means you are reading: stop moving things
    deck.addEventListener('pointerenter', stop);
    deck.addEventListener('pointerleave', play);
    deck.addEventListener('focusin', stop);
    deck.addEventListener('focusout', play);

    deck.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { show(at - 1); e.preventDefault(); }
      if (e.key === 'ArrowRight') { show(at + 1); e.preventDefault(); }
    });

    // swipe, for a touch screen
    let sx = 0;
    deck.addEventListener('pointerdown', (e) => { sx = e.clientX; }, { passive: true });
    deck.addEventListener('pointerup', (e) => {
      const dx = e.clientX - sx;
      if (Math.abs(dx) > 46) show(at + (dx < 0 ? 1 : -1));
    }, { passive: true });

    // the front card leans away from the pointer, and levels off when it is left alone
    if (!still) {
      let queued = false;
      let mx = 0, my = 0;
      const lean = () => {
        queued = false;
        const front = deck.querySelector<HTMLElement>('.slide.front .tilt');
        if (!front) return;
        front.style.transform = `perspective(1400px) rotateY(${mx * 7}deg) rotateX(${-my * 5}deg) translateZ(18px)`;
        const sheen = front.querySelector<HTMLElement>('.sheen');
        if (sheen) {
          sheen.style.setProperty('--sx', `${(mx + 1) * 50}%`);
          sheen.style.setProperty('--sy', `${(my + 1) * 50}%`);
        }
      };
      deck.addEventListener('pointermove', (e) => {
        const box = deck.getBoundingClientRect();
        mx = (e.clientX - box.left) / box.width * 2 - 1;
        my = (e.clientY - box.top) / box.height * 2 - 1;
        if (!queued) { queued = true; requestAnimationFrame(lean); }
      }, { passive: true });
      deck.addEventListener('pointerleave', () => {
        const front = deck.querySelector<HTMLElement>('.slide.front .tilt');
        if (front) front.style.transform = '';
      });
    }

    show(0);
    play();
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : play()));
  }
</script>
