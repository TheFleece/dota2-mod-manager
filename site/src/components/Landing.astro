---
/**
 * The landing, in whichever language the page asked for.
 *
 * The page opens with the product's name at full size rather than a sentence about it. That
 * is what the two sites in this corner of the internet that people actually like do, and it
 * is also the phrase somebody types into a search box. The sentence explaining it comes
 * second, where a sentence belongs.
 *
 * The numbers under it are the ones people read before they read anything: they are real and
 * checkable (see src/i18n/landing.ts), which is the only kind worth printing.
 *
 * The order after that answers a stranger's questions in the order they ask them: what does
 * it look like, what does it do, why should I run an unsigned .exe, and the usual worries.
 */
import { landing } from '../i18n/landing';
import Shots from './Shots.astro';
import Hunt from './Hunt.astro';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = landing[lang];

const GITHUB = 'https://github.com/TheFleece/dota2-mod-manager';
const RELEASES = `${GITHUB}/releases/latest`;
const WORKFLOW = `${GITHUB}/actions`;
const DISCORD = 'https://discord.gg/dota2pornfx';

// The badge says which version is current, read at build time. If GitHub cannot be reached
// while building, the badge simply does not appear - a stale version number would be worse.
let latestTag: string | null = null;
try {
  const r = await fetch('https://api.github.com/repos/TheFleece/dota2-mod-manager/releases/latest', {
    headers: { 'User-Agent': 'dota2modmanager-site' },
  });
  if (r.ok) latestTag = (await r.json()).tag_name ?? null;
} catch { /* offline build: no badge */ }

// the app is bilingual, so the window in the picture speaks the reader's language
const shot = (name: string) => `/screenshots/${lang}-${name}.webp`;

const shots = [
  { file: 'catalog', caption: c.shotCatalog, label: c.shotLabels[0], alt: lang === 'ru' ? 'Каталог модов в приложении' : 'The mod catalog inside the app' },
  { file: 'heroes', caption: c.shotHeroes, label: c.shotLabels[1], alt: lang === 'ru' ? 'Моды, сгруппированные по героям' : 'Mods grouped by hero' },
  { file: 'library', caption: c.shotLibrary, label: c.shotLabels[2], alt: lang === 'ru' ? 'Список установленных модов' : 'The list of installed mods' },
];
---

<section class="hero">
  <div class="wrap">
    {latestTag && (
      <a class="badge" href={RELEASES} rel="noopener">
        <span class="dot"></span>
        <b>{latestTag}</b>
        <span class="badge-sep"></span>
        <span>{c.latest}</span>
      </a>
    )}
    <p class="kicker">{c.heroKicker}</p>
    <h1>
      <span class="t1">{c.heroTitle}</span>
      <span class="t2">{c.heroTitleAccent}</span>
    </h1>
    <p class="lead">{c.heroLead}</p>

    <div class="btn-row">
      <a class="btn btn-glow" href={RELEASES} rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        {c.download}
      </a>
      <a class="btn ghost" href={GITHUB} rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.2-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.9 1.2 1.9 1.2 3.2 0 4.6-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z" />
        </svg>
        {c.source}
      </a>
    </div>
    <p class="muted">{c.heroMeta}</p>

    <ul class="stats reveal">
      {c.stats.map(([n, label]) => (
        <li>
          <b>{n}</b>
          <span>{label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="shots">
  <div class="wrap">
    <h2 class="sr-only">{c.shotsTitle}</h2>
    <Shots lang={lang} shots={shots} prev={c.prev} next={c.next} />
  </div>
</section>

<section>
  <div class="wrap">
    <h2 class="reveal">{c.whatTitle}</h2>
    <div class="cards">
      {c.cards.map(([title, body]) => (
        <article class="card reveal">
          <h3>{title}</h3>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="trust">
  <div class="wrap">
    <h2 class="reveal">{c.trustTitle}</h2>
    <p class="lead reveal">{c.trustLead}</p>
    <ul class="facts">
      {c.trustFacts.map(([title, body]) => (
        <li class="reveal">
          <b>{title}</b>
          <span>{body}</span>
        </li>
      ))}
    </ul>
    <div class="warn reveal">
      <h3>{c.smartscreenTitle}</h3>
      <p set:html={c.smartscreen} />
      <p class="muted">
        <a href={WORKFLOW} rel="noopener">{lang === 'ru' ? 'Посмотреть, как собираются релизы' : 'See how releases are built'}</a>
      </p>
    </div>
  </div>
</section>

<section>
  <div class="wrap narrow">
    <h2 class="reveal">{c.faqTitle}</h2>
    {c.faq.map(([q, a]) => (
      <details class="faq reveal">
        <summary>{q}</summary>
        <p>{a}</p>
      </details>
    ))}
  </div>
</section>

<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {[0, 1].map(() => (
      <div class="marquee-run">
        {c.marquee.map(([name, n]) => (
          <span class="marquee-item"><b>{n}</b>{name}</span>
        ))}
      </div>
    ))}
  </div>
</div>

<section class="final">
  <div class="wrap">
    <div class="final-box reveal">
      <img class="final-icon" src="/icon.png" width="84" height="84" alt="" />
      <h2>{c.ctaTitle}</h2>
      <p class="lead">{c.ctaLead}</p>
      <div class="btn-row">
        <a class="btn btn-glow btn-big" href={RELEASES} rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          {c.download}
        </a>
      </div>
      <p class="muted">{c.ctaMeta}</p>
    </div>

    <div class="links">
      <a class="link-card reveal" href={GITHUB} rel="noopener">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.2-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.9 1.2 1.9 1.2 3.2 0 4.6-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z" />
        </svg>
        <span><b>{c.linkGithub[0]}</b>{c.linkGithub[1]}</span>
        <i class="arr">&#8594;</i>
      </a>
      <a class="link-card reveal" href={DISCORD} rel="noopener">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.3 4.4A19.8 19.8 0 0 0 15.4 3l-.2.4c1.6.4 2.9 1 4.1 1.8a13.8 13.8 0 0 0-9.8-.9c-.6.2-1.1.3-1.6.5.2-.1.3-.2.4-.2A16 16 0 0 1 12 3.4L11.8 3a19.8 19.8 0 0 0-4.9 1.4C3.8 8.9 3 13.3 3.4 17.6a19.9 19.9 0 0 0 6 3l1.2-1.7c-.9-.3-1.7-.7-2.5-1.3l.5-.4a14.2 14.2 0 0 0 12.1 0l.5.4c-.8.6-1.6 1-2.5 1.3l1.2 1.7c2.2-.7 4.2-1.7 6-3 .5-5-.8-9.3-3.6-13.2zM9.3 15c-1.2 0-2.1-1.1-2.1-2.4 0-1.3.9-2.4 2.1-2.4 1.2 0 2.2 1.1 2.2 2.4 0 1.3-1 2.4-2.2 2.4zm5.4 0c-1.2 0-2.1-1.1-2.1-2.4 0-1.3.9-2.4 2.1-2.4 1.2 0 2.2 1.1 2.2 2.4 0 1.3-1 2.4-2.2 2.4z" />
        </svg>
        <span><b>{c.linkDiscord[0]}</b>{c.linkDiscord[1]}</span>
        <i class="arr">&#8594;</i>
      </a>
    </div>
  </div>
</section>

<Hunt found={c.huntFound} complete={c.huntComplete} hint={c.huntHint} />

<script>
  // A radial-gradient positioned by a custom property only knows the box it is painted in,
  // so each card is told where the pointer is in its own coordinates. One listener per
  // group, and the paint itself is the compositor's problem.
  for (const group of document.querySelectorAll<HTMLElement>('.stats, .cards')) {
    let queued = false;
    let ev: PointerEvent | null = null;
    const place = () => {
      queued = false;
      if (!ev) return;
      for (const card of group.children as HTMLCollectionOf<HTMLElement>) {
        const box = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${ev.clientX - box.left}px`);
        card.style.setProperty('--my', `${ev.clientY - box.top}px`);
      }
    };
    group.addEventListener('pointermove', (e) => {
      ev = e;
      if (!queued) { queued = true; requestAnimationFrame(place); }
    }, { passive: true });
  }
</script>

<script>
  // Sections arrive as they are scrolled to. One observer, one class, and everything is
  // already visible for anybody who asked for less motion (see .reveal in site.css).
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll('.reveal');
  if (still) {
    targets.forEach((el) => el.classList.add('shown'));
  } else {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en, i) => {
        if (!en.isIntersecting) return;
        // a short stagger inside one batch, so a row of cards does not land as one block
        (en.target as HTMLElement).style.transitionDelay = `${Math.min(i, 5) * 60}ms`;
        en.target.classList.add('shown');
        io.unobserve(en.target);
      });
    }, { rootMargin: '0px 0px -8% 0px' });
    targets.forEach((el) => io.observe(el));
  }
</script>
