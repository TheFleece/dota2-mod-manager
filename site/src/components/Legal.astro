---
/**
 * The privacy policy or the terms, in the site's layout. The words come from the repository
 * through lib/legal.ts, so the text the Discord application links to has one copy.
 */
import type { LegalDoc } from '../lib/legal';

interface Props { doc: LegalDoc }
const { doc } = Astro.props;
---

<article class="doc wrap">
  <h1>{doc.title}</h1>
  {doc.date && <p class="lead">{doc.date}</p>}
  <Fragment set:html={doc.body} />
</article>
