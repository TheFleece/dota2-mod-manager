---
/**
 * The one thing on this page you can operate.
 *
 * Every other section describes the program. This one hands over the part of it people
 * actually get wrong, and lets you break it and fix it in ten seconds: two mods that carry the
 * same file cannot both win, and the one in the lower pak slot is the one the game loads.
 * Switch mods on and off, drag them into a different order, and watch the winner change.
 *
 * Why this and not a prettier toy. It is ours: no competitor has this mechanic to copy,
 * because the mechanic is what the app is for. It needs no artwork from anybody - the names
 * are mods, the paths are paths, and every pixel here is drawn by this stylesheet - so there
 * is no question about whose picture is on the page. And it teaches the thing that generates
 * the most confused questions in Discord, by demonstration rather than by paragraph.
 *
 * The numbering starts at pak10 because that is where the app puts the first mod: everything
 * below is the game's own.
 */
interface Props {
  title: string;
  lead: string;
  slotsLabel: string;
  emptyLabel: string;
  winsLabel: string;
  coveredLabel: string;
  hint: string;
  moveLabel: string;
}
const { title, lead, slotsLabel, emptyLabel, winsLabel, coveredLabel, hint, moveLabel } = Astro.props;

// Real shapes: a hero set is a model plus its effects, a terrain is props and materials, a
// cursor is a panorama image. Two of these deliberately carry the same file, because that is
// the case worth showing.
const MODS = [
  { id: 'gopo', name: 'Gopo Pudge', cat: 'Heroes', files: ['models/heroes/pudge/pudge.vmdl', 'particles/pudge/meat_hook.vpcf'] },
  { id: 'butcher', name: 'Pudge Butcher Arcana', cat: 'Heroes', files: ['models/heroes/pudge/pudge.vmdl'] },
  { id: 'sakura', name: 'Sakura Pink Invoker', cat: 'Heroes', files: ['models/heroes/invoker/invoker.vmdl'] },
  { id: 'darkpoly', name: 'DarkPoly & Trees', cat: 'Terrains', files: ['models/props_tree/tree_01.vmdl', 'materials/terrain/ground.vmat'] },
  { id: 'ti8', name: 'TI8 Cursor', cat: 'Cursors', files: ['panorama/images/cursors/default.png'] },
];
---

<section class="stand-sec">
  <div class="wrap">
    <h2 class="reveal">{title}</h2>
    <p class="lead reveal">{lead}</p>

    <div class="stand reveal" id="stand" data-mods={JSON.stringify(MODS)}
         data-wins={winsLabel} data-covered={coveredLabel} data-empty={emptyLabel} data-move={moveLabel}>
      <ul class="stand-list" id="standList"></ul>
      <div class="stand-out">
        <div class="stand-out-head">{slotsLabel}</div>
        <ol class="stand-slots" id="standSlots"></ol>
        <p class="stand-verdict" id="standVerdict"></p>
      </div>
    </div>
    <p class="muted stand-hint reveal">{hint}</p>
  </div>
</section>

<script>
  const stand = document.getElementById('stand');
  const list = document.getElementById('standList');
  const slots = document.getElementById('standSlots');
  const verdict = document.getElementById('standVerdict');

  if (stand && list && slots && verdict) {
    type Mod = { id: string; name: string; cat: string; files: string[] };
    const mods = JSON.parse(stand.dataset.mods!) as Mod[];
    const WINS = stand.dataset.wins!;
    const COVERED = stand.dataset.covered!;
    const EMPTY = stand.dataset.empty!;
    const MOVE = stand.dataset.move!;

    // order is the list of ids top to bottom; on is which of them are switched on
    let order = mods.map((m) => m.id);
    const on = new Set(order);
    const byId = new Map(mods.map((m) => [m.id, m]));

    const paint = () => {
      // Slot numbers go to the mods that are on, in order. The first mod the app installs
      // lands in pak10; everything below that belongs to the game.
      const live = order.filter((id) => on.has(id));
      const slotOf = new Map(live.map((id, i) => [id, 10 + i]));

      // Who supplies each file, best (lowest) slot first. The lowest slot wins - that is the
      // whole rule, and it is why the order is worth dragging.
      const owner = new Map<string, string>();
      const loser = new Map<string, string[]>();
      for (const id of live) {
        for (const f of byId.get(id)!.files) {
          if (!owner.has(f)) owner.set(f, id);
          else loser.set(id, [...(loser.get(id) ?? []), f]);
        }
      }

      list.innerHTML = order.map((id, i) => {
        const m = byId.get(id)!;
        const covered = on.has(id) && loser.has(id);
        return `<li class="stand-row${on.has(id) ? '' : ' off'}${covered ? ' covered' : ''}" data-id="${id}" data-i="${i}">
          <button class="stand-grip" type="button" aria-label="${MOVE}: ${m.name}">
            <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
              <circle cx="5" cy="3" r="1.4"/><circle cx="11" cy="3" r="1.4"/>
              <circle cx="5" cy="8" r="1.4"/><circle cx="11" cy="8" r="1.4"/>
              <circle cx="5" cy="13" r="1.4"/><circle cx="11" cy="13" r="1.4"/>
            </svg>
          </button>
          <span class="stand-slot">${on.has(id) ? `pak${slotOf.get(id)}` : '—'}</span>
          <span class="stand-name">${m.name}${covered ? `<b class="stand-tag">${COVERED}</b>` : ''}</span>
          <span class="stand-cat">${m.cat}</span>
          <label class="stand-sw">
            <input type="checkbox" ${on.has(id) ? 'checked' : ''} data-on="${id}" aria-label="${m.name}">
            <i></i>
          </label>
        </li>`;
      }).join('');

      slots.innerHTML = live.length
        ? live.map((id) => `<li><span>pak${slotOf.get(id)}</span>${byId.get(id)!.name}</li>`).join('')
        : `<li class="stand-empty">${EMPTY}</li>`;

      // the contested file, named, with the mod the game actually loads it from
      const clash = [...loser.entries()][0];
      if (clash) {
        const file = clash[1][0];
        verdict.innerHTML = `<code>${file}</code><span>${WINS} <b>${byId.get(owner.get(file)!)!.name}</b></span>`;
        verdict.hidden = false;
      } else {
        verdict.hidden = true;
      }
    };

    list.addEventListener('change', (e) => {
      const box = e.target as HTMLInputElement;
      if (!box.dataset.on) return;
      if (box.checked) on.add(box.dataset.on); else on.delete(box.dataset.on);
      paint();
    });

    const moveTo = (id: string, to: number) => {
      const from = order.indexOf(id);
      const at = Math.max(0, Math.min(order.length - 1, to));
      if (from === at) return;
      order.splice(at, 0, ...order.splice(from, 1));
      paint();
      // keep the grip under the hand, or the keyboard user loses their place
      (list.querySelector(`[data-id="${id}"] .stand-grip`) as HTMLElement | null)?.focus();
    };

    // keyboard: the grip is a real button, and the arrows move the row it belongs to
    list.addEventListener('keydown', (e) => {
      const grip = (e.target as HTMLElement).closest('.stand-grip');
      if (!grip) return;
      const row = grip.closest('.stand-row') as HTMLElement;
      const dir = { ArrowUp: -1, ArrowDown: 1 }[(e as KeyboardEvent).key];
      if (!dir) return;
      e.preventDefault();
      moveTo(row.dataset.id!, Number(row.dataset.i) + dir);
    });

    // pointer: drag the grip, and the row follows the pointer between its neighbours
    let dragId: string | null = null;
    list.addEventListener('pointerdown', (e) => {
      const grip = (e.target as HTMLElement).closest('.stand-grip');
      if (!grip) return;
      dragId = (grip.closest('.stand-row') as HTMLElement).dataset.id!;
      grip.setPointerCapture?.((e as PointerEvent).pointerId);
      list.classList.add('dragging');
    });
    list.addEventListener('pointermove', (e) => {
      if (!dragId) return;
      const rows = [...list.querySelectorAll<HTMLElement>('.stand-row')];
      const y = (e as PointerEvent).clientY;
      // the index whose middle the pointer has passed
      let to = rows.findIndex((r) => { const b = r.getBoundingClientRect(); return y < b.top + b.height / 2; });
      if (to === -1) to = rows.length - 1;
      if (rows[to]?.dataset.id !== dragId) moveTo(dragId, to);
    });
    const drop = () => { dragId = null; list.classList.remove('dragging'); };
    list.addEventListener('pointerup', drop);
    list.addEventListener('pointercancel', drop);

    paint();
  }
</script>
