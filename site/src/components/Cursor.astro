---
/**
 * The light the pointer carries.
 *
 * Two things it has to get right, both of which the first attempt got wrong:
 *
 * It lights things rather than sitting behind them. Painted above the page and blended with
 * `screen`, so passing over a screenshot brightens it instead of disappearing under it. A
 * glow that vanishes the moment you point at the most interesting thing on the page is worse
 * than no glow.
 *
 * It has weight. The light trails the pointer and catches up, and it stretches slightly in
 * the direction of travel, so a flick of the mouse looks like something was moved rather
 * than teleported.
 *
 * It also publishes where it is, as --mx/--my on the document, which is what lets other
 * things on the page react to being lit without any of them listening to the pointer.
 */
---

<div id="cursor-glow" aria-hidden="true"><i></i></div>

<style>
  #cursor-glow {
    position: fixed;
    top: 0; left: 0;
    width: 0; height: 0;
    pointer-events: none;
    z-index: 4;
    opacity: 0;
    transition: opacity 500ms ease;
    will-change: transform;
  }
  #cursor-glow i {
    position: absolute;
    left: -240px; top: -240px;
    width: 480px; height: 480px;
    border-radius: 50%;
    background:
      radial-gradient(circle, color-mix(in srgb, var(--primary) 20%, transparent) 0%, transparent 42%),
      radial-gradient(circle, color-mix(in srgb, var(--primary) 7%, transparent) 0%, transparent 68%);
    /* screen keeps it additive: it can only make the page brighter, never dim it */
    mix-blend-mode: screen;
    will-change: transform;
  }
  @media (hover: none), (prefers-reduced-motion: reduce) {
    #cursor-glow { display: none; }
  }
</style>

<script>
  const glow = document.getElementById('cursor-glow');
  const halo = glow?.querySelector('i') as HTMLElement | null;
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (glow && halo && fine && !still) {
    let tx = -400, ty = -400;   // where the pointer is
    let x = -400, y = -400;     // where the light is
    let running = false;

    const frame = () => {
      const dx = tx - x;
      const dy = ty - y;
      x += dx * 0.16;
      y += dy * 0.16;

      // stretch along the direction of travel, a little, and only while moving fast
      const speed = Math.min(Math.hypot(dx, dy), 90);
      const stretch = 1 + speed / 320;
      const angle = speed > 2 ? (Math.atan2(dy, dx) * 180) / Math.PI : 0;

      glow.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      halo.style.transform = `rotate(${angle}deg) scale(${stretch}, ${1 / stretch})`;

      // let the rest of the page know where the light is
      const root = document.documentElement;
      root.style.setProperty('--mx', `${x}px`);
      root.style.setProperty('--my', `${y}px`);

      if (Math.abs(dx) > 0.3 || Math.abs(dy) > 0.3) requestAnimationFrame(frame);
      else running = false;
    };

    window.addEventListener('pointermove', (e) => {
      tx = e.clientX; ty = e.clientY;
      if (glow.style.opacity !== '1') glow.style.opacity = '1';
      if (!running) { running = true; requestAnimationFrame(frame); }
    }, { passive: true });

    document.addEventListener('pointerleave', () => { glow.style.opacity = '0'; });
  }
</script>
