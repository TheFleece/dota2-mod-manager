---
import Base from '../../layouts/Base.astro';
import CategoryMods from '../../components/CategoryMods.astro';
import { categoryText } from '../../i18n/categories';
import { categories } from '../../lib/categories';
import { categorySchema } from '../../lib/schema';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { id: category.id }, props: { category } }));
}

const { category } = Astro.props;
const c = categoryText('en', category.id);
const jsonLd = categorySchema('en', category);
---

<Base
  title={c.title}
  description={c.description}
  path={`/catalog/${category.id}/`}
  image={category.mods.find((m) => m.image)?.image ?? undefined}
>
  {jsonLd.map((node) => <script type="application/ld+json" slot="head" set:html={JSON.stringify(node)} />)}
  <CategoryMods lang="en" category={category} />
</Base>
