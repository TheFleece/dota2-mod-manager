---
import Base from '../layouts/Base.astro';
import Landing from '../components/Landing.astro';
import { landingSchema } from '../lib/schema';

const description = 'Free desktop app for Dota 2 mods: install skins, terrains, announcers and music from the community catalog, unlock cosmetics your account already owns, and share a whole setup as one link. Windows, open source.';

// What the app is, in the vocabulary a search engine reads: the software, the site, and the
// questions already answered further down the page.
const jsonLd = landingSchema('en');
---

<Base
  title="Dota 2 Mod Manager - install Dota 2 mods and free cosmetics in one click"
  description={description}
  path="/"
>
  {jsonLd.map((node) => <script type="application/ld+json" slot="head" set:html={JSON.stringify(node)} />)}
  <Landing lang="en" />
</Base>
