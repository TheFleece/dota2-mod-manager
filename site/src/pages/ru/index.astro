---
import Base from '../../layouts/Base.astro';
import Landing from '../../components/Landing.astro';
import { landingSchema } from '../../lib/schema';

const description = 'Бесплатная программа для модов Dota 2: скины, ландшафты, комментаторы и музыка из общего каталога, косметика, которая уже есть в аккаунте, и сборка, которой можно поделиться одной ссылкой. Windows, открытый код.';

const jsonLd = landingSchema('ru');
---

<Base
  title="Dota 2 Mod Manager - моды и бесплатная косметика для Dota 2 в один клик"
  description={description}
  path="/"
>
  {jsonLd.map((node) => <script type="application/ld+json" slot="head" set:html={JSON.stringify(node)} />)}
  <Landing lang="ru" />
</Base>
