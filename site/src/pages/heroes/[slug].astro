---
import Base from '../../layouts/Base.astro';
import HeroMods from '../../components/HeroMods.astro';
import { heroCopy } from '../../i18n/heroes';
import { heroes } from '../../lib/heroes';
import { heroSchema } from '../../lib/schema';

export function getStaticPaths() {
  return heroes.map((hero) => ({ params: { slug: hero.slug }, props: { hero } }));
}

const { hero } = Astro.props;
const c = heroCopy.en;
const jsonLd = heroSchema('en', hero);
---

<Base
  title={c.title.replace('{hero}', hero.name)}
  description={c.description.replace('{hero}', hero.name)}
  path={`/heroes/${hero.slug}/`}
  image={hero.mods.find((m) => m.image)?.image ?? undefined}
>
  {jsonLd.map((node) => <script type="application/ld+json" slot="head" set:html={JSON.stringify(node)} />)}
  <HeroMods lang="en" hero={hero} />
</Base>
