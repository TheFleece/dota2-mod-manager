{
  "name": "dota2-mod-manager",
  "productName": "Dota 2 Mod Manager",
  "version": "2.3.0",
  "description": "Desktop mod manager for Dota 2 — browse, install, toggle and preset 1100+ cosmetic mods from the Dota2PornFx catalog",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "test": "node --test \"test/**/*.test.js\"",
    "sandbox:seed": "node tools/sandbox.js seed",
    "sandbox:reset": "node tools/sandbox.js reset",
    "sandbox:status": "node tools/sandbox.js status",
    "start:sandbox": "electron . --user-data-dir=sandbox/userdata"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheFleece/dota2-mod-manager.git"
  },
  "author": "Mykhailo Lynnyk",
  "license": "GPL-3.0",
  "homepage": "https://github.com/TheFleece/dota2-mod-manager",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.thefleece.dota2modmanager",
    "productName": "Dota 2 Mod Manager",
    "icon": "build/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json",
      "CHANGELOG.md",
      "CHANGELOG.ru.md",
      "LICENSE",
      "NOTICE"
    ],
    "protocols": [
      {
        "name": "Dota 2 Mod Manager preset",
        "schemes": [
          "d2mm"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "d2mm",
        "name": "Dota 2 Mod Manager preset",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Dota-2-Mod-Manager-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Dota-2-Mod-Manager-Portable.${ext}",
      "requestExecutionLevel": "user"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "artifactName": "Dota-2-Mod-Manager-${version}.${ext}",
      "synopsis": "Mods for Dota 2, without the file juggling"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dota 2 Mod Manager",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "TheFleece",
      "repo": "dota2-mod-manager",
      "releaseType": "release"
    }
  }
}
